# Segurança e Rede (NUNCA versionar o .env real)
APP_ENV=production
BIND_ADDRESS=127.0.0.1:8080
ADMIN_API_TOKEN=change_me_to_a_64_char_random_hex_string
DATABASE_URL=sqlite://sentinel.db?mode=rwc

# Caminhos Iniciais (Seed para o banco na primeira execução)
DEFAULT_QUARANTINE_DIR=/mnt/samba_quarantine
DEFAULT_APPROVED_DIR=/mnt/homelab_storage/incoming
CLAMD_SOCKET_PATH=/var/run/clamav/clamd.ctl
SURICATA_EVE_PATH=/var/log/suricata/eve.json
